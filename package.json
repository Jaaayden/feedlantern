{
  "name": "feedlantern",
  "version": "0.10.0",
  "private": true,
  "type": "module",
  "description": "A self-hosted visual website-to-RSS builder with private cookie storage.",
  "license": "MIT",
  "engines": {
    "node": ">=24.0.0"
  },
  "packageManager": "pnpm@11.25.0",
  "scripts": {
    "dev": "concurrently -k 'tsx watch --env-file-if-exists=.env scripts/dev-server.ts' 'vite --host 127.0.0.1'",
    "build": "tsc --noEmit && vite build && pnpm --dir packages/cli build",
    "start": "node --import tsx --env-file-if-exists=.env src/server/index.ts",
    "admin:reset": "node --import tsx --env-file-if-exists=.env src/server/reset-password.ts",
    "typecheck": "tsc --noEmit",
    "test": "DEFAULT_LOCALE=zh-CN tsx --test tests/*.test.ts",
    "test:e2e": "playwright test",
    "browser:install": "playwright install chromium"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.3",
    "@fastify/static": "^10.1.7",
    "dom-serializer": "^3.1.1",
    "fast-xml-parser": "^5.11.2",
    "fastify": "^5.12.7",
    "htmlparser2": "^12.0.0",
    "ipaddr.js": "^2.2.0",
    "playwright": "^1.55.0",
    "sanitize-html": "^2.18.1",
    "tsx": "^4.23.15",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@playwright/test": "^1.55.0",
    "@types/node": "^24.3.0",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@types/sanitize-html": "^2.16.2",
    "@vitejs/plugin-react": "^5.0.2",
    "concurrently": "^10.0.6",
    "lucide-react": "^1.56.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  }
}
