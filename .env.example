# Copy to .env when overriding defaults. pnpm start/dev/admin:reset load .env.
HOST=127.0.0.1
PORT=4321
PUBLIC_ORIGIN=http://127.0.0.1:4321
DATA_DIR=./data

# HTTPS origins automatically enable Secure session cookies.
# COOKIE_SECURE=true

# Optional explicit Chromium executable; normally use pnpm browser:install.
# BROWSER_EXECUTABLE_PATH=/path/to/chromium

# Optional Playwright browser location. Set the same value when installing.
# PLAYWRIGHT_BROWSERS_PATH=0

# Empty by default. Exact host:port exceptions for intentional private targets.
# ALLOWED_TARGET_HOSTS=internal.example:8080

# For local proxy Fake-IP DNS environments. Queries Cloudflare DNS over HTTPS;
# returned addresses still pass SSRF checks and the proxy connects to fixed IPs.
# DNS_OVER_HTTPS=true

# Only trust the exact address of your reverse proxy; empty disables forwarding trust.
# TRUSTED_PROXIES=127.0.0.1,::1

# Background refresh/import capacity: integer 1–4; defaults to 1.
# BACKGROUND_CONCURRENCY=2

# Configure Bark and application/server settings in the web Settings page.
# Existing BARK_URL and server values migrate only on first initialization.
